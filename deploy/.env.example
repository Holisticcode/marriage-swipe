# Copy to .env and fill in. Never commit .env.
DOMAIN=marriage.example.com
POSTGRES_PASSWORD=
JWT_SECRET=
MEDIA_SECRET=
# Shown on the privacy policy / rules pages
CONTACT_EMAIL=support@example.com
OPERATOR_NAME=Your Company Pty Ltd
# Email (needed for password reset codes). Any SMTP provider works.
SMTP_HOST=
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
MAIL_FROM=Marriage Swipe <no-reply@example.com>
REQUIRE_EMAIL_VERIFICATION=false
# Optional: URL that receives {"to":"+61...","text":"..."} to send SMS codes
SMS_WEBHOOK_URL=
